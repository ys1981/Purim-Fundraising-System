{
  "name": "purim-fundraising-system",
  "version": "0.2.0",
  "description": "מערכת שולחנית לניהול מגבית פורים",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "maplibre-gl": "^5.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "il.purim.fundraising",
    "productName": "מערכת מגבית פורים",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "src/map-view.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "maps/israel.mbtiles",
        "to": "maps/israel.mbtiles",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
