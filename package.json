{
  "name": "purim-fundraising-system",
  "version": "0.1.0",
  "description": "מערכת מקומית לניהול מגבית פורים",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "il.purim.fundraising",
    "productName": "מערכת מגבית פורים",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "README.md"],
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}